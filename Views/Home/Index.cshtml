@{
    ViewData["Title"] = "Home";
}

<section class="py-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="text-uppercase text-muted mb-2">RetailECommerce</p>
            <h1 class="display-4 fw-bold">A simple boilerplate home page for the storefront.</h1>
            <p class="lead mt-3">
                This page is now routed through <strong>Home/Index</strong>, which matches the default MVC route.
            </p>
            <div class="d-flex gap-3 mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Privacy" asp-action="Index">Privacy</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="p-4 p-md-5 rounded-4 bg-light border">
                <h2 class="h4">Page structure</h2>
                <ul class="mb-0">
                    <li>Hero section</li>
                    <li>Feature summary</li>
                    <li>Responsive layout</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="features" class="py-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5">Clean routing</h3>
                    <p class="mb-0">The home page resolves from the default controller route.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5">Boilerplate layout</h3>
                    <p class="mb-0">A starter HTML structure is ready for real storefront content.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5">Bootstrap ready</h3>
                    <p class="mb-0">The page uses the existing Bootstrap layout and site styles.</p>
                </div>
            </div>
        </div>
    </div>
</section>