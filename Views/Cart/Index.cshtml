@{
    ViewData["Title"] = "Shopping Cart";
    var items = (ViewBag.CartItems as IEnumerable<RetailECommerce.Models.CartItem>) ?? Enumerable.Empty<RetailECommerce.Models.CartItem>();
    decimal subtotal = ViewBag.Subtotal ?? 0m;
}

<h1 class="mb-4">Shopping Cart</h1>

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-success">@TempData["CartMessage"]</div>
}

@if (!items.Any())
{
    <div class="text-center py-5">
        <p class="fs-4 text-muted">Your cart is empty.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Browse Products</a>
    </div>
}
else
{
    <form id="checkoutForm" asp-controller="Checkout" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
    </form>

    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th>
                    <input type="checkbox" id="selectAll" />
                    Select All
                </th>
                <th>Product</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>
                        <input type="checkbox"
                               class="product-checkbox"
                               name="selectedProductIds"
                               value="@item.ProductId"
                               form="checkoutForm"
                               checked />
                    </td>

                    <td>@item.Name</td>

                    <td class="text-center">
                        <form asp-controller="Cart" asp-action="UpdateCart" method="post" class="d-inline-flex gap-2 justify-content-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control form-control-sm"
                                   style="width:80px;" />

                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                Update
                            </button>
                        </form>
                    </td>

                    <td class="text-end">$@item.Price.ToString("0.00")</td>
                    <td class="text-end">$@((item.Price * item.Quantity).ToString("0.00"))</td>

                    <td class="text-end">
                        <form asp-controller="Cart" asp-action="DeleteFromCart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end">
        <h4>Subtotal: $@subtotal.ToString("0.00")</h4>

        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
            Continue Shopping
        </a>

        <button type="submit" form="checkoutForm" class="btn btn-primary">
            Proceed to Checkout
        </button>
    </div>
}

<script>
document.addEventListener("DOMContentLoaded", function () {
    const selectAll = document.getElementById("selectAll");
    const checkboxes = document.querySelectorAll(".product-checkbox");

    function updateSelectAllStatus() {
        const allChecked = Array.from(checkboxes).every(function (checkbox) {
            return checkbox.checked;
        });

        selectAll.checked = allChecked;
    }

    // On page load, automatically check Select All if every product is selected.
    updateSelectAllStatus();

    // Toggle all product checkboxes when Select All is clicked.
    selectAll.addEventListener("change", function () {
        checkboxes.forEach(function (checkbox) {
            checkbox.checked = selectAll.checked;
        });
    });

    // Update Select All whenever an individual product checkbox changes.
    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener("change", function () {
            updateSelectAllStatus();
        });
    });
});
</script>