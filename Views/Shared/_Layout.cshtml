@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RetailECommerce</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RetailECommerce.styles.css" asp-append-version="true" />
</head>
<body>
     @{
      var userName = Context.Session.GetString("UserEmail");
      var userRole = Context.Session.GetString("UserRole");
      var userFullName = Context.Session.GetString("FullName");
     }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RetailECommerce</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
              <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 order-2 order-sm-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cart" asp-action="Index">🛒 Cart</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                        </li>
                    </ul> <ul class="navbar-nav ms-auto order-1 order-sm-2">

                       
                            @if (userName != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Orders">My Orders</a>
                                </li>
                                <li class="nav-item" >
                                    <a class="nav-link text-dark" asp-area="" data-bs-toggle="modal" data-bs-target="#myAccountModalDialog" >My Account</a>
                                </li>
                           
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                                        <button type="submit" class="nav-link text-dark btn btn-link border-0 p-0 m-0 text-start align-baseline">
                                            Logout (@userName)
                                        </button>
                                    </form>
                                </li>
                            }

                            else {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="SignUp" asp-action="Index">Sign Up</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="SignIn" asp-action="Index">Sign In</a>
                            </li>
                        }
                        
                      
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


   @if (userName != null){

             <div class="modal fade" id="myAccountModalDialog" tabindex="-1" aria-labelledby="myAccountModalLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="myAccountModalLabel">My Account</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p><strong>Email:</strong> @userName</p>
                                                <p><strong>Role:</strong> @userRole</p>
                                                <p><strong>Full Name:</strong> @userFullName</p>

                                            </div>
                                            <div class="modal-footer">
                                                <a asp-area="" asp-controller="Account" asp-action="EditProfilePage" class="btn btn-primary">Edit Profile</a> 
                                                <button type="button" class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Orders">View My Orders</button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
           </div>
    
   }
   
    

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RetailECommerce - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
