@{
    ViewData["Title"] = "Sign Up";
}

<section class="auth-page sign-in-page">
    <div class="auth-backdrop"></div>
    <div class="auth-card shell-card">
        <div class="auth-copy">
            <p class="auth-kicker">RetailECommerce</p>
            <h1>Create an account</h1>
            <p class="auth-subtitle">Get started with your free account today.</p>

            <div class="auth-credentials-card mt-4 p-4 rounded text-white" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                <h3 class="h5 mb-3" style="font-weight: 600; letter-spacing: 0.5px;">Demo Credentials</h3>
                
                <div class="mb-3">
                    <strong class="d-block" style="color: #ffd700;">Admin</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">admin@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">admin123</code>
                </div>

                <div class="mb-3">
                    <strong class="d-block" style="color: #4db8ff;">Customer 1</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer1@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer123</code>
                </div>

                <div class="mb-3">
                    <strong class="d-block" style="color: #4db8ff;">Customer 2</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer2@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer123</code>
                </div>

                <div>
                    <strong class="d-block" style="color: #4db8ff;">Customer 3</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer3@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer123</code>
                </div>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-header">
                <p class="section-label">Sign Up</p>
                <h2>Create an account</h2>
                <p>Fill in the details below to get started.</p>
            </div>

            @model RetailECommerce.Models.User
            <form class="auth-form" method="post" asp-action="Register" asp-controller="SignUp">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" id="email" name="email" class="form-control form-control-lg" placeholder="yourname@example.com" required>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" type="text" id="fullname" name="fullname" class="form-control form-control-lg" placeholder="Your Full Name" required>
                    <span asp-validation-for="FullName" class="text-danger"></span> 
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Enter your password" required>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">

                </div>

                <div class="auth-actions">
                    <label class="remember-me">
                        <input type="checkbox" name="remember" />
                        <span>Remember me</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 auth-submit">Sign Up</button>
            </form>

            <p class="auth-footer">Already have an account? <a asp-controller="SignIn" asp-action="Index">Sign in</a></p>
        </div>
    </div>
</section>


@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
