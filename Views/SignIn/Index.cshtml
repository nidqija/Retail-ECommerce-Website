@{
    ViewData["Title"] = "Sign In";
}

<section class="auth-page sign-in-page">
    <div class="auth-backdrop"></div>
    <div class="auth-card shell-card">
        <div class="auth-copy">
            <p class="auth-kicker">RetailECommerce</p>
            <h1>Welcome back</h1>
            <p class="auth-subtitle">Sign in to continue managing your store, orders, and customers.</p>

            <div class="auth-credentials-card mt-4 p-4 rounded text-white" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1);">
                <h3 class="h5 mb-3" style="font-weight: 600; letter-spacing: 0.5px;">Demo Credentials</h3>
                
                <div class="mb-3">
                    <strong class="d-block" style="color: #ffd700;">Admin</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">admin@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">admin123</code>
                </div>

                <div class="mb-3">
                    <strong class="d-block" style="color: #4db8ff;">Customer 1</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer1@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer123</code>
                </div>

                <div class="mb-3">
                    <strong class="d-block" style="color: #4db8ff;">Customer 2</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer2@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer123</code>
                </div>

                <div>
                    <strong class="d-block" style="color: #4db8ff;">Customer 3</strong>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer3@example.com</code><br>
                    <code style="color: #e0e0e0; background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px;">customer123</code>
                </div>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-form-header">
                <p class="section-label">Sign In</p>
                <h2>Access your account</h2>
                <p>Enter your credentials to resume where you left off.</p>
                
            </div>

            @if (ViewBag.ShowError == true)
            {
                <div class="alert alert-warning alert-dismissible fade show border-0 rounded-0 shadow-sm mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <span></span>
                        <div>
                            <strong>Authentication Required.</strong> Please sign in to your account to view that page or complete your order.
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form class="auth-form" method="post" asp-action="Authenticate" asp-controller="SignIn">
                <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>
                <div class="mt-3">
                <input  type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" name="email" class="form-control form-control-lg" placeholder="yourname@example.com" required>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Enter your password" required>
                </div>

                <div class="auth-actions">
                    <label class="remember-me">
                        <input type="checkbox" name="remember" />
                        <span>Remember me</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 auth-submit mb-2">Sign In</button>
            </form>

            <p class="auth-footer">New here? <a asp-controller="SignUp" asp-action="Index">Create an account</a></p>
            <p class="auth-footer">Are you an admin? <a asp-controller="Admin" asp-action="Index">Sign in here</a></p>
        </div>
    </div>
</section>