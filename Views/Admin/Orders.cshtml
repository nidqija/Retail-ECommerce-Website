@{
    ViewData["Title"] = "Order Management";
    var orders = ViewBag.Orders as IEnumerable<RetailECommerce.Models.Order>
                 ?? Enumerable.Empty<RetailECommerce.Models.Order>();
}

<h1 class="mb-4">Order Management</h1>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in orders)
                    {
                        <tr>
                            <td class="fw-semibold">#@o.Id</td>
                            <td>@o.OrderDate.ToString("MMM d, yyyy HH:mm")</td>
                            <td>@o.User?.FullName</td>
                            <td class="text-end">$@o.TotalAmount.ToString("0.00")</td>
                            <td class="text-center">
                                @{
                                    var badgeClass = o.OrderStatus switch
                                    {
                                        "Completed" => "bg-success",
                                        "Pending"   => "bg-warning text-dark",
                                        "Cancelled" => "bg-danger",
                                        _           => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@o.OrderStatus</span>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="OrderDetails"
                                   asp-route-id="@o.Id" class="btn btn-outline-primary btn-sm">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-muted small">
    @orders.Count() order(s) shown.
    <a asp-controller="Admin" asp-action="Index">← Back to Admin Home</a>
</div>
