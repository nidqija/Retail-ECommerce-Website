@{
    ViewData["Title"] = "Admin Enquiries";
    var enquiries = ViewBag.Enquiries as List<RetailECommerce.Models.Enquiry>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0 text-uppercase small fw-bold">Admin Panel</p>
        <h1 class="mb-0">Enquiry Management</h1>
    </div>
    <div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>
    </div>
</div>

<!-- Enquiry Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-light h-100 shadow-sm">
            <div class="card-body">
                <p class="text-muted small text-uppercase fw-bold mb-1">Total Enquiries</p>

                @if (enquiries == null)
                {
                    <p class="h3 fw-bold mb-0">0</p>
                }
                else
                {
                <p class="h3 fw-bold mb-0">@enquiries.Count</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-warning h-100 shadow-sm">
            <div class="card-body">
                <p class="card-title small text-uppercase fw-bold mb-1 opacity-75">Pending</p>

                @if (enquiries == null)
                {
                    <p class="h3 fw-bold mb-0">0</p>
                }
                else
                {
                <p class="h3 fw-bold mb-0">@enquiries.Count(e => e.Status == "Pending")</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success h-100 shadow-sm">
            <div class="card-body">
                <p class="card-title small text-uppercase fw-bold mb-1 opacity-75">Resolved</p>
                @if (enquiries == null)
                {
                    <p class="h3 fw-bold mb-0">0</p>
                }
                else
                {
                    <p class="h3 fw-bold mb-0">@enquiries.Count(e => e.Status == "Closed")</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-tabs mb-3" id="enquiryTabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" type="button">All</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" type="button">Pending</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" type="button">Resolved</button>
    </li>
</ul>

<!-- Enquiries Table Feed -->
<div class="card shadow-sm">
    <div class="card-header fw-bold">✉️ Customer Messages (Hardcoded for now)</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                       <th style="width: 15%;">Date</th>
                        <th style="width: 15%;">Customer</th>
                        <th style="width: 20%;">Product</th>
                        <th style="width: 30%;">Message</th>
                        <th style="width: 10%;" class="text-center">Status</th>
                        <th style="width: 10%;" class="text-center">Actions</th>
                        <th style="width: 10%;" class="text-center">Closure</th>
                    </tr>
                </thead>
                <tbody>
                     

                    @if (enquiries != null && enquiries.Count > 0){
                        
                        foreach (var enquiry in enquiries){

                            
                            <tr> 
                                <td>@enquiry.CreatedAt.ToString("g")</td>


                                <td>
                                    @if (enquiry.User != null) {
                                        @enquiry.User.FullName
                                    }else
                                        {
                                            <span class="text-muted font-monospace">ID: @enquiry.UserId</span>
                                        }
                                   
                                </td>
                                    <td>
                                        @if (enquiry.Product != null) {
                                            @enquiry.Product.Name
                                        }

                                        else
                                            {
                                                <span class="text-muted font-monospace">ID: @enquiry.ProductId</span>
                                            }
                                    </td>

                                    
                                <td><span class="text-truncate d-inline-block" style="max-width: 250px;">@enquiry.Message</span></td>
                               
                                <td class="text-center">@enquiry.Status</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@enquiry.ProductId" class="btn btn-sm btn-outline-primary py-0 px-2">
                                            View
                                        </a>
                                    </div>
                                </td>

                                @if(enquiry.Status == "Replied"){
                                     <td class="text-center">
                                          <div class="btn-group" role="group">
                                            <form method="post" asp-controller="Enquiry" asp-action= "CloseEnquiry" asp-route-id="@enquiry.ProductId">
                                              <input type="hidden" name="enquiryId" value="@enquiry.EnquiryId" />
                                              <input type="hidden" name="productId" value="@enquiry.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2">
                                                        Close Enquiry
                                                    </button>
                                             </form>
                                           </div>
                                      </td>
                                }

                                @if(enquiry.Status == "Closed"){
                                    <td>
                                        <span class="badge bg-success">Closed</span>
                                    </td>
                                }
                               

                            </tr>
                            
                        }

                    }

                  
                  
                   
                  
                </tbody>
            </table>
        </div>
    </div>
</div>