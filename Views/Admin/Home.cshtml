@{
    ViewData["Title"] = "Admin Dashboard";
    var summary = ViewBag.DashboardSummary as RetailECommerce.Models.DTOs.DashboardSummaryDTO;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0 text-uppercase small fw-bold">Admin Panel</p>
        <h1 class="mb-0">Dashboard Overview</h1>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary h-100 shadow-sm">
            <div class="card-body">
                <p class="card-title small text-uppercase fw-bold mb-1 opacity-75">Total Revenue</p>
                <p class="display-6 fw-bold mb-0">@summary.TotalRevenue.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-dark bg-warning h-100 shadow-sm">
            <div class="card-body">
                <p class="card-title small text-uppercase fw-bold mb-1 opacity-75">Pending Orders</p>
                <p class="display-6 fw-bold mb-0">@summary.PendingOrdersCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger h-100 shadow-sm">
            <div class="card-body">
                <p class="card-title small text-uppercase fw-bold mb-1 opacity-75">Out of Stock</p>
                <p class="display-6 fw-bold mb-0">@summary.LowStockAlertsCount</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">🛍 Product Management</div>
            <div class="card-body d-flex gap-2">
                <a asp-controller="Admin" asp-action="Products" class="btn btn-outline-primary">View All Products</a>
                <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-success">+ Add Product</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">📦 Order Management</div>
            <div class="card-body">
                <a asp-controller="Admin" asp-action="Orders" class="btn btn-outline-primary">View All Orders</a>
            </div>
        </div>
    </div>
     <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">❓ Enquiry Management</div>
            <div class="card-body">
                <a class="btn btn-outline-primary" asp-controller="Enquiry" asp-action="Index">View All Enquiries</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-bold">📝 Product Review Management</div>
            <div class="card-body">
                <a class="btn btn-outline-primary" asp-controller="Review" asp-action="Index"
                >View All Reviews</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Feed -->
<div class="card shadow-sm">
    <div class="card-header fw-bold">🕐 Recent Orders</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th class="text-end">Amount</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in summary.RecentOrders)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.OrderDate.ToString("g")</td>
                        <td class="text-end">@order.TotalAmount.ToString("C")</td>
                        <td class="text-center">
                            @if (order.OrderStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (order.OrderStatus == "Completed")
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.OrderStatus</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-controller="Admin" asp-action="Orders" class="btn btn-link p-0">View all orders →</a>
    </div>
</div>

<!-- Report Link -->
<div class="mt-3">
    <a asp-controller="Report" asp-action="Index" class="btn btn-outline-secondary btn-sm">📊 Go to Reports</a>
</div>