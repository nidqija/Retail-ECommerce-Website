<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Report Page</title>
</head>
<body>
    <!-- Bootstrap Floating Success Notification (Kept outside the form for safety) -->
    

    <h1>This is the Admin Report Page</h1>

    <div id="successNotification" class="alert alert-success alert-dismissible fade position-fixed top-0 end-0 m-3 d-none" role="alert" style="z-index: 1050;">
        <strong>Success!</strong> Your report has been generated and download started.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Native form: It passes parameters automatically on submission -->
    <form id="reportForm" asp-controller="Report" asp-action="GenerateReport" method="get">
        
        <label for="monthSelect">Select Month:</label>
        <select id="monthSelect" name="month">
            <option value="1">January</option>
            <option value="2">February</option>
            <option value="3">March</option>
            <option value="4">April</option>
            <option value="5">May</option>
            <option value="6">June</option>
            <option value="7">July</option>
            <option value="8">August</option>
            <option value="9">September</option>
            <option value="10">October</option>
            <option value="11">November</option>
            <option value="12">December</option>
        </select>
        
        <br><br>
       
        <button type="submit" name="reportType" value="PDF">Export Report as PDF</button>
        <button type="submit" name="reportType" value="Excel">Export Report as Excel</button>
        
    </form>

    @section Scripts {
        <script>
            // Target the form submission event
            document.getElementById('reportForm').addEventListener('submit', function() {
                const successNotification = document.getElementById('successNotification');
                
                // 1. Reveal the alert instantly when clicked
                successNotification.classList.remove('d-none');
                successNotification.classList.add('show');

                // 2. Automatically hide the alert after 4 seconds
                setTimeout(() => {
                    successNotification.classList.remove('show');
                    
                    // Allow 150ms for Bootstrap fade animation to end before applying display none
                    setTimeout(() => {
                        successNotification.classList.add('d-none');
                    }, 150);
                }, 4000);
            });
        </script>
    }
</body>
</html>