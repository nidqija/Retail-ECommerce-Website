<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Report Control Center</title>
    <!-- Core Bootstrap 5 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts for clean typography -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .dashboard-container {
            max-width: 1000px;
            margin: 3rem auto;
        }
        .page-header {
            font-weight: 700;
            letter-spacing: -0.025em;
            color: #0f172a;
        }
        /* Custom Modern Card Design */
        .report-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .report-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }
        .card-title {
            font-weight: 600;
            color: #334155;
        }
        /* Custom Styling for Select Fields */
        .custom-select {
            background-color: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-weight: 500;
            color: #475569;
            transition: border-color 0.15s ease-in-out;
        }
        .custom-select:focus {
            border-color: #6366f1;
            outline: none;
        }
        /* Refined Export Buttons */
        .btn-export {
            font-weight: 500;
            border-radius: 8px;
            padding: 0.6rem 1.2rem;
            transition: all 0.2s ease;
        }
        .btn-pdf {
            background-color: #ef4444;
            color: #ffffff;
            border: none;
        }
        .btn-pdf:hover {
            background-color: #dc2626;
            color: #ffffff;
        }
        .btn-csv {
            background-color: #10b981;
            color: #ffffff;
            border: none;
        }
        .btn-csv:hover {
            background-color: #059669;
            color: #ffffff;
        }
        /* Toast Notification Styling */
        .custom-toast {
            border-radius: 12px;
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
            border-left: 5px solid #10b981;
        }
    </style>
</head>
<body>

    <div class="container dashboard-container px-4">
        
        <!-- Toast Notification Banner System -->
        <div id="successNotification" class="alert alert-success alert-dismissible fade position-fixed top-0 end-0 m-4 d-none custom-toast" role="alert" style="z-index: 1050; background: white; color: #1e293b;">
            <div class="d-flex align-items-center">
                <span class="me-2" style="color: #10b981; font-size: 1.25rem;">✔</span>
                <div>
                    <strong>Generation Complete!</strong><br>
                    <span class="text-muted small">Your file download has started automatically.</span>
                </div>
            </div>
            <button type="button" class="btn-close ms-3" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <!-- Header -->
        <div class="mb-5">
            <h1 class="page-header m-0">Management Reports</h1>
            <p class="text-muted">Select and generate programmatic data pipelines down into local storage partitions.</p>
        </div>

        <!-- SEGMENT 1: PAYMENT CARDS -->
        <div class="report-card p-4 mb-4">
            <div class="d-flex align-items-center mb-3">
                <h2 class="h4 card-title m-0">Financial & Payment History</h2>
            </div>
            <p class="text-muted small mb-4">Generates comprehensive breakdowns of customer invoicing parameters filtered by selected calendar cycles.</p>
            
            <form class="report-form" asp-controller="Report" asp-action="GenerateReport" method="get">
                <input type="hidden" name="reportType" value="" />

                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <label for="monthSelect" class="form-label col-form-label-sm fw-semibold text-secondary">Reporting Period:</label>
                    </div>
                    <div class="col-md-4">
                        <select id="monthSelect" name="month" class="form-select custom-select w-100">
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-export btn-pdf report-btn" name="dataType" data-format="PDF" value="PaymentReport">Export Ledger as PDF</button>
                        <button type="submit" class="btn btn-export btn-csv report-btn" name="dataType" data-format="CSV" value="PaymentReport">Export Ledger as CSV</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- SEGMENT 2: OTHER CORES -->
        <div class="report-card p-4">
            <h2 class="h4 card-title mb-2">Core System Collections</h2>
            <p class="text-muted small mb-4">Static system audits across foundational data architectures including item inventory configurations and system registration nodes.</p>
            
            <form class="report-form" asp-controller="Report" asp-action="GenerateReport" method="get">
                <input type="hidden" name="reportType" value="" />
                
                <div class="d-flex flex-wrap gap-3">
                    <button type="submit" class="btn btn-export btn-pdf report-btn" name="dataType" data-format="PDF" value="ProductReport">Products Catalog (PDF)</button>
                    <button type="submit" class="btn btn-export btn-pdf report-btn" name="dataType" data-format="PDF" value="UserReport">Users Directory (PDF)</button>
                    
                    <div class="w-100 my-1 d-none d-md-block"></div> <!-- Clean Visual Separator Break -->

                    <button type="submit" class="btn btn-export btn-csv report-btn" name="dataType" data-format="CSV" value="ProductReport">Products Spreadsheet (CSV)</button>
                    <button type="submit" class="btn btn-export btn-csv report-btn" name="dataType" data-format="CSV" value="UserReport">Users Spreadsheet (CSV)</button>
                </div>
            </form>
        </div>

    </div>

    @section Scripts {
        <script>
            // Contextual strategy selection routing via relative node chains
            document.querySelectorAll('.report-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const parentForm = this.closest('form');
                    const formatValue = this.getAttribute('data-format');
                    parentForm.querySelector('input[name="reportType"]').value = formatValue;
                });
            });

            // Modern, smooth toast notifications matching standard UX architectures
            document.querySelectorAll('.report-form').forEach(form => {
                form.addEventListener('submit', function() {
                    const successNotification = document.getElementById('successNotification');
                    
                    successNotification.classList.remove('d-none');
                    successNotification.classList.add('show');

                    setTimeout(() => {
                        successNotification.classList.remove('show');
                        setTimeout(() => {
                            successNotification.classList.add('d-none');
                        }, 150);
                    }, 5000);
                });
            });
        </script>
    }
</body>
</html>