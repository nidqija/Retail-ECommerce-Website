@{
    ViewData["Title"] = "Admin Dashboard";
    var products = ViewBag.Products as IEnumerable<RetailECommerce.Models.Product>
                   ?? Enumerable.Empty<RetailECommerce.Models.Product>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Admin — Product Management</h1>
    <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-success">
        + Add New Product
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px">ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center" style="width:140px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in products)
                    {
                        <tr>
                            <td class="text-muted">#@p.ProductId</td>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="text-muted small">@(p.Description.Length > 50 ? p.Description[..50] + "…" : p.Description)</td>
                            <td class="text-end">$@p.Price.ToString("0.00")</td>
                            <td class="text-center">
                                @if (p.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                                else if (p.StockQuantity <= 10)
                                {
                                    <span class="badge bg-warning text-dark">Low (@p.StockQuantity)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@p.StockQuantity</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="EditProduct"
                                   asp-route-id="@p.ProductId"
                                   class="btn btn-outline-primary btn-sm me-1" title="Edit">Edit</a>
                                <form asp-controller="Admin" asp-action="DeleteProduct"
                                      asp-route-id="@p.ProductId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            title="Delete"
                                            onclick="return confirm('Delete this product?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 text-muted small">
    Showing @products.Count() product(s).
    <a asp-controller="Admin" asp-action="Index">← Back to Admin Home</a>
</div>
