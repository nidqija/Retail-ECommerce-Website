@{
    ViewData["Title"] = "Notifications";
    var notifications = (ViewBag.Notifications as IEnumerable<RetailECommerce.Models.Notification>)
        ?? Enumerable.Empty<RetailECommerce.Models.Notification>();
}

<div class="container mt-4">
    <h1 class="mb-4">Notifications</h1>

    @if (!notifications.Any())
    {
        <div class="alert alert-info">
            You have no notifications yet.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notification in notifications)
            {
                var isPayment = notification.Type.ToString() == "PaymentUpdate";
                var title = isPayment ? "Payment Update" : "Vendor Reply";
                var buttonText = isPayment ? "View Order" : "View Reply";

                <a asp-controller="Notification"
                   asp-action="Open"
                   asp-route-id="@notification.NotificationId"
                   class="list-group-item list-group-item-action mb-3 rounded shadow-sm border @(notification.IsRead ? "bg-white" : "bg-light")">

                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <strong>@title</strong>

                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-danger rounded-pill">NEW</span>
                                }
                            </div>

                            <p class="mb-2 mt-2 text-dark">
                                @notification.Message
                            </p>

                            <span class="text-primary small fw-semibold">
                                @buttonText →
                            </span>
                        </div>

                        <small class="text-muted text-nowrap">
                            @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </small>
                    </div>
                </a>
            }
        </div>
    }
</div>

<script>
    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>