@{
    ViewData["Title"] = "New Password";
    // Checks if the email is passed via ViewBag or falls back to a query parameter string
    var userEmail = ViewBag.Email ?? Context.Request.Query["email"].ToString();
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="card shadow-sm border-0 rounded-3 w-100" style="max-width: 450px;">
        <div class="card-body p-4 p-sm-5">
            
            <div id="verification-step" class="text-center py-4">
                <div id="loading-icon" class="mb-4">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                
                <div id="success-icon" class="mb-4 d-none text-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                    </svg>
                </div>

                <h3 id="verification-status" class="h5 font-weight-bold text-secondary mb-2">
                    Verifying your secure link...
                </h3>
                <p class="text-muted small mb-0">
                    Please wait while we validate your request.
                </p>
            </div>

            <div id="password-form-step" class="d-none">
                <div class="text-center mb-4">
                    <h2 class="h3 font-weight-bold text-dark mb-2">
                        Create New Password
                    </h2>
                    <p class="text-muted small">
                        Please enter your new secure password below.
                    </p>
                </div>

                <form method="POST" asp-action="ChangePassword" asp-controller="Account">

                    <div class="mb-3">
                        <label for="email" class="form-label text-secondary small fw-medium">Email Address</label>
                        <input id="email" name="email" type="email"  required 
                               class="form-control" placeholder="you@example.com">
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label text-secondary small fw-medium">New Password</label>
                        <input id="password" name="newPassword" type="password" required 
                               class="form-control" placeholder="••••••••">
                    </div>
                    
                    <div class="mb-4">
                        <label for="confirm-password" class="form-label text-secondary small fw-medium">Confirm New Password</label>
                        <input id="confirm-password" name="confirmPassword" type="password" required 
                               class="form-control" placeholder="••••••••">
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-medium shadow-sm">
                        Reset Password
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const loadingIcon = document.getElementById("loading-icon");
        const successIcon = document.getElementById("success-icon");
        const statusText = document.getElementById("verification-status");
        const verificationStep = document.getElementById("verification-step");
        const passwordFormStep = document.getElementById("password-form-step");

        setTimeout(() => {
            loadingIcon.classList.add("d-none");
            successIcon.classList.remove("d-none");
            
            statusText.innerText = "Link Verified!";
            statusText.classList.remove("text-secondary");
            statusText.classList.add("text-success");

            setTimeout(() => {
                verificationStep.classList.add("d-none");
                passwordFormStep.classList.remove("d-none");
            }, 1000);

        }, 2500); 
    });
</script>