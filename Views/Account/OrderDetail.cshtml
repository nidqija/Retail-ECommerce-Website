@{
    ViewData["Title"] = "Order Details";
    var order = ViewBag.Order as dynamic ?? new { };
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Order Details</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Account" asp-action="Orders" class="btn btn-outline-secondary">← Back to Orders</a>
        </div>
    </div>

    @if (order == null)
    {
        <div class="alert alert-danger">Order not found.</div>
    }
    else
    {
        <!-- Order Header Card -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h5 class="mb-0">Order #@order.OrderId</h5>
                        <small class="text-light">Placed on @(((DateTime)order.Date).ToString("MMMM d, yyyy"))</small>
                    </div>
                    <div class="col-md-4 text-end">
                        @{
                            var status = order.Status.ToString();
                            var badgeClass = status switch
                            {
                                "Completed" => "bg-success",
                                "Pending"   => "bg-warning text-dark",
                                "Failed"    => "bg-danger",
                                "Refunded"  => "bg-info text-dark",
                                _           => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass" style="font-size: 1rem; padding: 0.5rem 1rem;">@status</span>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted mb-3">Order Summary</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="text-muted">Order ID:</td>
                                <td class="fw-semibold">#@order.OrderId</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Order Date:</td>
                                <td class="fw-semibold">@(((DateTime)order.Date).ToString("MMM d, yyyy"))</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Status:</td>
                                <td>
                                    <span class="badge @{
                                        var s = order.Status.ToString();
                                        switch(s) {
                                            case "Completed": { <text>bg-success</text> } break;
                                            case "Pending": { <text>bg-warning text-dark</text> } break;
                                            case "Failed": { <text>bg-danger</text> } break;
                                            case "Refunded": { <text>bg-info text-dark</text> } break;
                                            default: { <text>bg-secondary</text> } break;
                                        }
                                    }">@order.Status</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-3">Shipping Information</h6>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="text-muted">Estimated Delivery:</td>
                                <td class="fw-semibold">@(order.EstimatedDelivery?.ToString("MMM d, yyyy") ?? "Pending")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Payment Method:</td>
                                <td class="fw-semibold">@(order.PaymentMethod ?? "Not specified")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Tracking Number:</td>
                                <td class="fw-semibold">@(order.TrackingNumber ?? "Not available yet")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Order Status Timeline -->
                <h6 class="text-muted mb-3">Order Status Timeline</h6>
                <div class="timeline">
                    @{
                        var statusList = new[] { "Pending", "Processing", "Shipped", "Delivered" };
                        var currentStatusIndex = statusList.ToList().IndexOf(order.Status.ToString());
                    }
                    @for (int i = 0; i < statusList.Length; i++)
                    {
                        var isCompleted = i <= currentStatusIndex;
                        var isCurrent = i == currentStatusIndex;
                        <div class="timeline-item mb-3">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <div class="timeline-dot @(isCompleted ? "bg-success" : "bg-light border border-2 border-secondary")">
                                        <i class="bi @(isCompleted ? "bi-check-circle-fill" : "bi-circle") text-@(isCompleted ? "success" : "secondary")" style="font-size: 1.5rem;"></i>
                                    </div>
                                </div>
                                <div class="col">
                                    <h6 class="@(isCurrent ? "text-dark fw-bold" : "text-muted")">@statusList[i]</h6>
                                    @if (isCurrent)
                                    {
                                        <small class="text-info">Current Status</small>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Order Items</h5>
            </div>
            <div class="card-body">
                @if (order.Items != null && ((System.Collections.IEnumerable)order.Items).Cast<dynamic>().Any())
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.Items)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.ProductName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">$@(((decimal)item.UnitPrice).ToString("0.00"))</td>
                                        <td class="text-end fw-semibold">$@(((decimal)item.Subtotal).ToString("0.00"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Order Total -->
                    <div class="row mt-4">
                        <div class="col-md-8"></div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal:</span>
                                        <span>$@(order.Subtotal?.ToString("0.00") ?? "0.00")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax:</span>
                                        <span>$@(order.Tax?.ToString("0.00") ?? "0.00")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Shipping:</span>
                                        <span>$@(order.Shipping?.ToString("0.00") ?? "0.00")</span>
                                    </div>
                                    <hr />
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Total:</span>
                                        <span class="fs-5 text-success">$@(((decimal)order.Total).ToString("0.00"))</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">No items in this order.</div>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-4 mb-4">
            @if (order.Status.ToString() == "Pending")
            {
                <button class="btn btn-warning" onclick="alert('Cancel order feature coming soon!')">⛔ Cancel Order</button>
            }
            else if (order.Status.ToString() == "Completed")
            {
                <button class="btn btn-info" onclick="alert('Return request feature coming soon!')">🔄 Request Return</button>
            }
            <button class="btn btn-outline-primary" onclick="window.print()">🖨️ Print Order</button>
        </div>
    }
</div>

<style>
    .timeline-dot {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .timeline-item {
        padding-left: 2rem;
        border-left: 3px solid #dee2e6;
    }

    .timeline-item:last-child {
        border-left: none;
    }
</style>
