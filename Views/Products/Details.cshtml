@{
    ViewData["Title"] = "Product Details";
    var p = ViewBag.Product as RetailECommerce.Models.Product;
    var enquiries = ViewBag.Enquiries as List<RetailECommerce.Models.Enquiry>;
    var reviews = ViewBag.Reviews as List<RetailECommerce.Models.Review>;
}

@if (p == null)
{
    <div class="alert alert-warning mt-4">Product not found.</div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">← Back to Catalog</a>
}
else
{
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Catalog</a></li>
            <li class="breadcrumb-item active" aria-current="page">@p.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-md-5">
            <div class="bg-light rounded-4 d-flex align-items-center justify-content-center"
                 style="height: 360px; font-size: 6rem;">
                📦
            </div>
        </div>

        <div class="col-md-7">
            <h1 class="mb-2">@p.Name</h1>
            <p class="text-muted">SKU: #@p.ProductId</p>
            <hr />
            <p class="lead">@p.Description</p>

            <div class="mb-3">
                @if (p.StockQuantity > 0)
                {
                    <span class="badge bg-success fs-6">In Stock — @p.StockQuantity units left</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Out of Stock</span>
                }
            </div>

            <div class="fs-2 fw-bold text-primary mb-4">$@p.Price.ToString("0.00")</div>

            <div class="d-flex align-items-center gap-3 mb-3">
                <label for="qty" class="form-label mb-0 fw-semibold">Qty:</label>
                <input type="number" id="qty" name="qty" value="1" min="1" max="@p.StockQuantity"
                       class="form-control" style="width:80px;" @(p.StockQuantity == 0 ? "disabled" : "") />
                <button class="btn btn-primary btn-lg flex-grow-1" @(p.StockQuantity == 0 ? "disabled" : "")>
                    🛒 Add to Cart
                </button>
            </div>

            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                ← Back to Catalog
            </a>
        </div>
    </div>

    <section class="mt-5 pt-4 border-top">
        
        <ul class="nav nav-tabs mb-4" id="productTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold text-dark" id="feedback-tab" data-bs-toggle="tab" data-bs-target="#feedback-panel" type="button" role="tab" aria-controls="feedback-panel" aria-selected="true">
                    💬 Customer Feedback (3)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold text-dark" id="questions-tab" data-bs-toggle="tab" data-bs-target="#questions-panel" type="button" role="tab" aria-controls="questions-panel" aria-selected="false">
                    
                    🙋 Questions & Answers ( @enquiries?.Count )
                </button>
            </li>
        </ul>

        <div class="tab-content" id="productTabContent">
            
            <div class="tab-pane fade show active" id="feedback-panel" role="tabpanel" aria-labelledby="feedback-tab">
                <div class="max-w-md" style="max-width: 800px;">
                   

                    @if (reviews != null && reviews.Count > 0)
                    {
                        foreach (var review in reviews)
                        {
                          <div class="mb-4 pb-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <span class="fw-bold d-block d-sm-inline me-sm-2">@review.User?.FullName</span>
                                        <small class="text-muted" style="font-size: 0.8rem;">
                                            @review.CreatedAt.ToString("MMM dd, yyyy")
                                        </small>
                                    </div>
                                    
                                    <div class="text-warning fs-6 flex-shrink-0">
                                        @for (int i = 0; i < review.rating; i++)
                                        {
                                            <span>★</span>
                                        }
                                        @for (int i = 0; i < (5 - review.rating); i++)
                                        {
                                            <span class="text-muted">★</span>
                                        }
                                    </div>
                                </div>

                                <p class="text-muted small mb-0">
                                    @review.Comment
                                </p>

                                @if(User.IsInRole("Vendor")){
                                    <div class="mt-2">
                                        @if(review.status == "Pending"){
                                             <span class="badge bg-warning">Status: @review.status</span>
                                             <div class="d-flex justify-content-end">
                                             <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#replyModal-@review.ReviewId" >Reply</button>
                                             <!-- Reply Modal -->
                                             <!-- Main Modal Wrapper -->
                                            <div class="modal fade" id="replyModal-@review.ReviewId" tabindex="-1" aria-labelledby="replyModalLabel-@review.ReviewId" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        
                                                        <!-- Modal Header -->
                                                        <div class="modal-header">
                                                            <h5 class="modal-title" id="replyModalLabel-@review.ReviewId">Respond to Feedback</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>

                                                        <!-- Form Processing -->
                                                        <form asp-controller="Review" asp-action="UpdateReview" method="POST">
                                                            
                                                            <!-- Modal Body -->
                                                            <div class="modal-body">
                                                               <input type="hidden" name="ReviewId" value="@review.ReviewId" />
                                                               <input type="hidden" name="ProductId" value="@review.ProductId" />
                                                                
                                                                <!-- Customer Message Context Box -->
                                                                <div class="mb-4 p-3 bg-light rounded border">
                                                                    <small class="text-muted d-block mb-1 text-uppercase tracking-wider font-weight-bold" style="font-size: 0.75rem;">Customer's Message: @review.Comment</small>
                                                                </div>
                                                                
                                                                <!-- Input Form Field -->
                                                                <div class="mb-3">
                                                                    <label for="replyText" class="form-label font-weight-bold">Your Response</label>
                                                                    <textarea class="form-control" id="replyText" name="VendorReply" rows="4" placeholder="Type your reply here..." required></textarea>
                                                                </div>
                                                            </div>

                                                            <!-- Modal Footer -->
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-primary">Send Reply</button>
                                                            </div>
                                                            
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                             </div>

                                             
                                        } else if (review.status == "Replied") {
                                            <!-- Status Badge -->
                                                <div class="mb-2">
                                                    <span class="badge bg-success fs-7">Status: @review.status</span>
                                                </div>

                                                <!-- Structured Vendor Reply Box -->
                                                <div class="mt-2 p-3 bg-light rounded border-start border-success border-3">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-bold text-success small">
                                                            ✉️ Vendor Response
                                                        </span>
                                                        
                                                        <!-- Contextual Action Buttons placed elegantly inside the reply area -->
                                                        <div>
                                                            <button class="btn btn-sm btn-link text-decoration-none p-0 me-2" 
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#editReplyModal-@review.ReviewId">
                                                                ✏️ Edit
                                                            </button>
                                                        </div>
                                                    </div>
                                                    
                                                    <!-- The actual reply text -->
                                                    <p class="mb-0 text-dark small fst-italic">
                                                        "@review.VendorReply"
                                                    </p>
                                                </div>

                                            <div class="modal fade" id="editReplyModal-@review.ReviewId" tabindex="-1" aria-labelledby="editReplyModalLabel-@review.ReviewId" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold" id="editReplyModalLabel-@review.ReviewId">Manage Your Response</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>

                                                        <form asp-controller="Review" asp-action="UpdateReview" method="POST">
                                                            <div class="modal-body text-start">
                                                                <input type="hidden" name="ReviewId" value="@review.ReviewId" />
                                                                <input type="hidden" name="ProductId" value="@review.ProductId" />
                                                                
                                                                <div class="mb-3 p-3 bg-light rounded border">
                                                                    <small class="text-muted d-block mb-1 text-uppercase tracking-wider font-weight-bold" style="font-size: 0.75rem;">Customer's Message:</small>
                                                                    <p class="mb-0 small fst-italic">"@review.Comment"</p>
                                                                </div>
                                                                
                                                                <div class="mb-3">
                                                                    <label for="editReplyText-@review.ReviewId" class="form-label fw-bold">Your Response</label>
                                                                    <textarea class="form-control" id="editReplyText-@review.ReviewId" name="VendorReply" rows="4" required>@review.VendorReply</textarea>
                                                                    <small class="form-text text-muted">Modify your response message above and click Save Changes.</small>
                                                                </div>
                                                            </div>

                                                            <div class="modal-header border-top-0 pt-0 d-flex justify-content-between JSON-gap align-items-center">
                                                                <div>
                                                                    <button type="submit"
                                                                            class="btn btn-danger"
                                                                            asp-controller="Review"
                                                                            asp-action="DeleteVendorReply"
                                                                            asp-route-reviewId="@review.ReviewId"
                                                                            asp-route-productId="@review.ProductId"
                                                                            formmethod="post"
                                                                            onclick="return confirm('Are you sure you want to delete this reply?');">
                                                                        Delete Reply
                                                                    </button>
                                                                </div>
                                                            
                                                                <div>
                                                                    <button type="button" class="btn btn-secondary btn-sm me-1" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-primary btn-sm px-3">Save Changes</button>
                                                                </div>
                                                            </div>
                                                        </form>

                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small italic">No reviews yet for this product.</p>
                    }
                    
                   
                </div>
            </div>

            <div class="tab-pane fade" id="questions-panel" role="tabpanel" aria-labelledby="questions-tab">
                <div class="row g-4">

                    

                    <div class="col-lg-7">
                       
                       @if (enquiries != null && enquiries.Count > 0){
                          foreach (var enquiry in enquiries)
                          {
                              <div class="mb-4 pb-3 border-bottom">
                                  <div class="d-flex justify-content-between align-items-center mb-1">
                                      <span class="fw-bold">@enquiry.User.FullName</span>
                                      <small class="text-muted">@enquiry.CreatedAt.ToString("MMM dd, yyyy")</small>
                                  </div>
                                  <p class="text-muted small mb-0">@enquiry.Message</p>
                                  

                                  @if (!string.IsNullOrEmpty(enquiry.ReplyMessage))
                                  {
                                        <div class="mt-3 bg-light p-3 rounded">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-success">Vendor Reply</span>
                                                <small class="text-muted  ">@enquiry.CreatedAt.ToString("MMM dd, yyyy")</small>
                                            </div>
                                            <p class="mb-0 small">@enquiry.ReplyMessage</p>
                                        </div>
                                    }

                                  @if(User.IsInRole("Vendor")){
                                        <div class="mt-2">
                                            @if(enquiry.Status == "Pending"){
                                                 <span class="badge bg-warning">Status: @enquiry.Status</span>
                                            }else if(enquiry.Status == "Replied"){
                                                 <span class="badge bg-success">Status: @enquiry.Status</span>
                                            }

                                            @if(enquiry.Status == "Pending"){
                                                <div class="d-flex justify-content-end">
                                                <button class="btn btn-sm btn-outline-success ms-3" data-bs-toggle="modal" data-bs-target="#replyModal-@enquiry.EnquiryId">Reply</button>


                                                <div class="modal fade" id="replyModal-@enquiry.EnquiryId" tabindex="-1" aria-labelledby="replyModalLabel-@enquiry.EnquiryId" aria-hidden="true">
                                                        <div class="modal-dialog modal-dialog-centered">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title fw-bold" id="replyModalLabel-@enquiry.EnquiryId">Reply to @enquiry.User.FullName</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <form asp-controller="Enquiry" asp-action="UpdateEnquiry" method="POST">
                                                                    <div class="modal-body text-start">
                                                                        <input type="hidden" name="EnquiryId" value="@enquiry.EnquiryId" />
                                                                        <input type="hidden" name="ProductId" value="@enquiry.ProductId" />

                                                                        <div class="mb-2 bg-light p-2 rounded">
                                                                            <small class="text-muted d-block">Question:</small>
                                                                            <p class="mb-0 small italic">"@enquiry.Message"</p>
                                                                        </div>

                                                                        <div class="mb-3">
                                                                            <label >Your Response:</label>
                                                                            <textarea class="form-control" name="ReplyMessage" rows="4" placeholder="Type your formal solution here..." required></textarea>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-success btn-sm px-4">Send Reply</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    </div>
                                            } 

                                         
                                        </div>
                                  }

                                  
                              </div>
                          }
                       }

                    </div>

                    <div class="col-lg-5">
                        <div class="card border p-4 bg-white shadow-sm rounded-3">
                            <h5 class="h6 fw-bold mb-2">Have a specific question?</h5>
                            <p class="text-muted x-small mb-3" style="font-size: 0.85rem;">Get answers from our staff and community members who own this product.</p>
                            
                            <form action="#" method="POST" onsubmit="event.preventDefault(); alert('Mock question submitted!');">
                                <div class="mb-3">
                                    <textarea class="form-control" rows="3" placeholder="Type your question here (e.g., Is it waterproof?)..." required></textarea>
                                </div>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-dark btn-sm px-4">Post Question</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
}