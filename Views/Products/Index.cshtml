@{
    ViewData["Title"] = "Product Catalog";
    var products = ViewBag.Products as IEnumerable<RetailECommerce.Models.Product> ?? Enumerable.Empty<RetailECommerce.Models.Product>();
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var subCategories = ViewBag.SubCategories as List<string> ?? new List<string>();
    var searchKeyword = ViewBag.SearchKeyword as string ?? "";
    var selectedCategory = ViewBag.SelectedCategory as string ?? "";
    var selectedSubCategory = ViewBag.SelectedSubCategory as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Product Catalog (hardcoded HTML data,not linked to database) </h1>
    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary">
        🛒 View Cart
    </a>
</div>

<!-- Search and Filter Bar -->
<div class="card mb-4 p-3 bg-light">
    <div class="row g-3 align-items-end">
        <!-- Search Bar -->
        <div class="col-md-5">
            <label for="searchInput" class="form-label fw-bold">🔍 Search Products</label>
            <form method="get" asp-controller="Products" asp-action="Index" class="d-flex gap-2">
                <input type="text" 
                       id="searchInput"
                       name="searchKeyword" 
                       class="form-control" 
                       placeholder="Search by product name or description..." 
                       value="@searchKeyword">
                <button type="submit" class="btn btn-primary">Search</button>
                @if (!string.IsNullOrEmpty(searchKeyword))
                {
                    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Clear</a>
                }
            </form>
        </div>

        <!-- Category Filter -->
        <div class="col-md-3">
            <label for="categoryFilter" class="form-label fw-bold">📂 Category</label>
            <form method="get" asp-controller="Products" asp-action="Index" id="categoryForm">
                <div class="d-flex gap-2">
                    <select id="categoryFilter" name="category" class="form-select" onchange="document.getElementById('categoryForm').submit();">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat" selected="@(selectedCategory == cat)">@cat</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(selectedCategory))
                    {
                        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary btn-sm">✕</a>
                    }
                </div>
                <input type="hidden" name="searchKeyword" value="@searchKeyword">
                <input type="hidden" name="subCategory" value="@selectedSubCategory">
            </form>
        </div>

        <!-- SubCategory Filter -->
        <div class="col-md-3">
            <label for="subCategoryFilter" class="form-label fw-bold">🏷️ Sub-Category</label>
            <form method="get" asp-controller="Products" asp-action="Index" id="subCategoryForm">
                <div class="d-flex gap-2">
                    <select id="subCategoryFilter" name="subCategory" class="form-select" onchange="document.getElementById('subCategoryForm').submit();">
                        <option value="">All Sub-Categories</option>
                        @foreach (var subCat in subCategories)
                        {
                            <option value="@subCat" selected="@(selectedSubCategory == subCat)">@subCat</option>
                        }
                    </select>
                    @if (!string.IsNullOrEmpty(selectedSubCategory))
                    {
                        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary btn-sm">✕</a>
                    }
                </div>
                <input type="hidden" name="searchKeyword" value="@searchKeyword">
                <input type="hidden" name="category" value="@selectedCategory">
            </form>
        </div>

        <!-- Results Counter -->
        <div class="col-md-1">
            <div class="alert alert-info mb-0 text-center">
                <small><strong>@products.Count()</strong> found</small>
            </div>
        </div>
    </div>
</div>

@if (!products.Any())
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
        <span>⚠️</span>
        <div>
            No products match your search criteria. 
            @if (!string.IsNullOrEmpty(searchKeyword) || !string.IsNullOrEmpty(selectedCategory))
            {
                <a asp-controller="Products" asp-action="Index" class="alert-link">View all products</a>
            }
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var p in products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                         style="height:180px; font-size:3rem;">
                        📦
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@p.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fw-bold fs-5 text-primary">$@p.Price.ToString("0.00")</span>
                            @if (p.StockQuantity > 0)
                            {
                                <span class="badge bg-success">In Stock (@p.StockQuantity)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Out of Stock</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex gap-2">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId"
                           class="btn btn-outline-secondary btn-sm flex-grow-1">View Details</a>
                        @if (p.StockQuantity > 0)
                        {
                            <button class="btn btn-primary btn-sm flex-grow-1" type="button">Add to Cart</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
