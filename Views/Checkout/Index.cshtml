@using RetailECommerce.Models
@{
    ViewData["Title"] = "Checkout";
    var orderItems = (ViewBag.OrderItems as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    decimal subtotal = ViewBag.Subtotal ?? 0m;
    decimal tax      = ViewBag.Tax      ?? 0m;
    decimal total    = ViewBag.Total    ?? 0m;
    var availableDiscounts = (ViewBag.AvailableDiscounts as IEnumerable<Discount>) ?? Enumerable.Empty<Discount>();
    var usedDiscountIds = (ViewBag.UsedDiscountIds as HashSet<int>) ?? new HashSet<int>();
}

<div class="container mt-5">
    <h2>Checkout</h2>
    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        </div>
    }
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Message
        </div>
    }

    <div class="row">
        <div class="col-md-7">
            <h4>Select Payment Method</h4>
            <form asp-controller="Checkout" asp-action="Process" method="post" id="checkoutForm" enctype="multipart/form-data">
                <input type="hidden" name="subtotal" value="@ViewBag.Subtotal" />

                <!-- Discount Code Selection -->
                <div class="mb-4">
                    <label for="discountCode" class="form-label"><strong>Discount Code</strong></label>
                    <select class="form-select" name="discountCode" id="discountCode">
                        <option value="" data-pct="0">No discount</option>
                        @foreach (var d in availableDiscounts)
                        {
                            var alreadyUsed = usedDiscountIds.Contains(d.Id);
                            <option value="@d.DiscountCode" data-pct="@d.DiscountPercentage" disabled="@(alreadyUsed ? "disabled" : null)">
                                @d.DiscountCode — @d.DiscountName (@d.DiscountPercentage.ToString("0.##")% off)@(alreadyUsed ? " — already used" : "")
                            </option>
                        }
                    </select>
                    @if (!availableDiscounts.Any())
                    {
                        <small class="text-muted">No active discount codes are available right now.</small>
                    }
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentType" id="paymentCard" value="card" required checked>
                        <label class="form-check-label" for="paymentCard">Credit / Debit Card</label>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="radio" name="paymentType" id="paymentQR" value="qr" required>
                        <label class="form-check-label" for="paymentQR">QR Pay (TNG eWallet, GrabPay)</label>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="radio" name="paymentType" id="paymentCOD" value="cod" required>
                        <label class="form-check-label" for="paymentCOD">Cash on Delivery</label>
                    </div>
                </div>

                <!-- Card Details Section -->
                <div id="cardDetailsContainer" class="border p-3 rounded bg-light mb-4">
                    <h5>Card Details</h5>
                    <div class="mb-2">
                        <label>Card Number</label>
                        <input type="text" class="form-control" placeholder="1234 5678 9101 1121" />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label>Expiry Date</label>
                            <input type="text" class="form-control" placeholder="MM/YY" />
                        </div>
                        <div class="col-6">
                            <label>CVV</label>
                            <input type="text" class="form-control" placeholder="123" />
                        </div>
                    </div>
                </div>

                <!-- QR Payment Info Section -->
                <div id="qrPaymentContainer" class="border p-3 rounded bg-light mb-4" style="display: none;">
                    <h5>📱 QR Payment</h5>
                    <p class="text-muted">Open your camera and point it at your payment QR code (TNG eWallet / GrabPay). Payment completes automatically as soon as the QR is detected.</p>
                    <button type="button" id="openCameraButton" class="btn btn-info">📷 Open Camera &amp; Scan</button>
                    <div id="qrScannerArea" class="mt-3" style="display: none;">
                        <video id="qrVideo" muted playsinline class="w-100 border rounded" style="max-width: 400px;"></video>
                        <p id="qrScanStatus" class="text-muted mt-2 mb-0">Point your camera at the QR code…</p>
                    </div>
                    <!-- Captured camera frame is attached here and verified server-side. -->
                    <input type="file" name="qrProof" id="qrProof" class="d-none" accept="image/*" tabindex="-1" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100" id="placeOrderButton">Place Order (@ViewBag.Total.ToString("C"))</button>
                </div>
            </form>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    Order Summary
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in ViewBag.OrderItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Name (x@(item.Quantity))
                                <span>@((item.Price * item.Quantity).ToString("C"))</span>
                            </li>
                        }
                        @if (!((IEnumerable<dynamic>)ViewBag.OrderItems).Any())
                        {
                            <li class="list-group-item text-muted">Your cart is empty.</li>
                        }
                    </ul>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Subtotal:</strong>
                        <span>@ViewBag.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between text-success" id="discountRow" style="display:none;">
                        <strong>Discount (<span id="discountLabel"></span>):</strong>
                        <span id="discountValue">-$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <strong>Tax (8%):</strong>
                        <span id="taxValue">@ViewBag.Tax.ToString("C")</span>
                    </div>
                    <h4 class="mt-3 d-flex justify-content-between">
                        Total: <span id="totalValue">@ViewBag.Total.ToString("C")</span>
                    </h4>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-check-label {
        cursor: pointer;
        user-select: none;
    }

    .form-check-input:checked ~ .form-check-label {
        font-weight: 500;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const paymentTypeRadios = document.querySelectorAll('input[name="paymentType"]');
        const cardDetailsContainer = document.getElementById('cardDetailsContainer');
        const qrPaymentContainer = document.getElementById('qrPaymentContainer');

        // Payment method selection handler
        paymentTypeRadios.forEach(radio => {
            radio.addEventListener('change', function () {
                handlePaymentMethodChange(this.value);
            });
        });

        function handlePaymentMethodChange(paymentMethod) {
            // Hide all containers
            cardDetailsContainer.style.display = 'none';
            qrPaymentContainer.style.display = 'none';

            // Show relevant container
            if (paymentMethod === 'card') {
                cardDetailsContainer.style.display = 'block';
            } else if (paymentMethod === 'qr') {
                qrPaymentContainer.style.display = 'block';
            }
            // For COD, show nothing - just the Place Order button
        }

        // Initialize with card payment selected
        handlePaymentMethodChange('card');
    });
</script>

<!-- Live discount + total recalculation -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const SUBTOTAL = parseFloat('@ViewBag.Subtotal') || 0;
        const TAX_RATE = 0.08;

        const discountSelect = document.getElementById('discountCode');
        const discountRow = document.getElementById('discountRow');
        const discountLabel = document.getElementById('discountLabel');
        const discountValue = document.getElementById('discountValue');
        const taxValue = document.getElementById('taxValue');
        const totalValue = document.getElementById('totalValue');
        const placeOrderButton = document.getElementById('placeOrderButton');

        const money = v => '$' + v.toFixed(2);

        function recalculate() {
            const selected = discountSelect.options[discountSelect.selectedIndex];
            const pct = parseFloat(selected.getAttribute('data-pct')) || 0;

            const discountAmount = Math.round(SUBTOTAL * (pct / 100) * 100) / 100;
            const discountedSubtotal = SUBTOTAL - discountAmount;
            const tax = Math.round(discountedSubtotal * TAX_RATE * 100) / 100;
            const total = discountedSubtotal + tax;

            if (pct > 0) {
                discountLabel.textContent = pct + '%';
                discountValue.textContent = '-' + money(discountAmount);
                discountRow.style.display = 'flex';
            } else {
                discountRow.style.display = 'none';
            }

            taxValue.textContent = money(tax);
            totalValue.textContent = money(total);
            placeOrderButton.textContent = 'Place Order (' + money(total) + ')';
        }

        discountSelect.addEventListener('change', recalculate);
        recalculate();
    });
</script>

<!-- jsQR: client-side QR detection from the live camera feed -->
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('checkoutForm');
        const openCameraButton = document.getElementById('openCameraButton');
        const scannerArea = document.getElementById('qrScannerArea');
        const video = document.getElementById('qrVideo');
        const statusText = document.getElementById('qrScanStatus');
        const qrProofInput = document.getElementById('qrProof');

        // Offscreen canvas used to grab video frames for jsQR (and to capture
        // the detected frame, which is sent to the server for verification).
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });

        let stream = null;
        let scanning = false;
        let qrCompleted = false;

        openCameraButton.addEventListener('click', async function () {
            if (scanning) return;

            try {
                stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: 'environment' },
                    audio: false
                });
            } catch (err) {
                statusText.textContent = ' Could not access the camera. Please allow camera permission and try again.';
                statusText.classList.remove('text-muted');
                statusText.classList.add('text-danger');
                scannerArea.style.display = 'block';
                return;
            }

            video.srcObject = stream;
            await video.play();

            scannerArea.style.display = 'block';
            statusText.textContent = 'Point your camera at the QR code…';
            statusText.classList.remove('text-danger', 'text-success', 'fw-semibold');
            statusText.classList.add('text-muted');
            openCameraButton.disabled = true;

            scanning = true;
            requestAnimationFrame(scanLoop);
        });

        function stopCamera() {
            scanning = false;
            if (stream) {
                stream.getTracks().forEach(t => t.stop());
                stream = null;
            }
            openCameraButton.disabled = false;
        }

        function scanLoop() {
            if (!scanning) return;

            if (video.readyState === video.HAVE_ENOUGH_DATA) {
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                ctx.drawImage(video, 0, 0);

                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const code = jsQR(imageData.data, canvas.width, canvas.height);

                if (code) {
                    // QR found: freeze everything and complete the payment
                    // immediately with the captured frame as proof.
                    scanning = false;
                    statusText.textContent = ' QR code detected — completing payment…';
                    statusText.classList.remove('text-muted', 'text-danger');
                    statusText.classList.add('text-success', 'fw-semibold');

                    canvas.toBlob(function (blob) {
                        stopCamera();

                        const file = new File([blob], 'qr-scan.png', { type: 'image/png' });
                        const dt = new DataTransfer();
                        dt.items.add(file);
                        qrProofInput.files = dt.files;

                        qrCompleted = true;
                        form.submit();
                    }, 'image/png');
                    return;
                }
            }

            requestAnimationFrame(scanLoop);
        }

        // For QR payments the scan IS the payment - block manual submission
        // until a QR has been scanned.
        form.addEventListener('submit', function (e) {
            const selected = document.querySelector('input[name="paymentType"]:checked');
            if (selected && selected.value === 'qr' && !qrCompleted) {
                e.preventDefault();
                scannerArea.style.display = 'block';
                statusText.textContent = 'Please scan your payment QR code first - click "Open Camera & Scan".';
                statusText.classList.remove('text-muted', 'text-success', 'fw-semibold');
                statusText.classList.add('text-danger');
            }
        });

        // Switching away from QR Pay shuts the camera off.
        document.querySelectorAll('input[name="paymentType"]').forEach(radio => {
            radio.addEventListener('change', function () {
                if (this.value !== 'qr') {
                    stopCamera();
                    scannerArea.style.display = 'none';
                }
            });
        });
    });
</script>