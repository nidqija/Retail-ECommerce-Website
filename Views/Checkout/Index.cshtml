@using RetailECommerce.Models
@{
    ViewData["Title"] = "Checkout";
    var orderItems = (ViewBag.OrderItems as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
    decimal subtotal = ViewBag.Subtotal ?? 0m;
    decimal tax      = ViewBag.Tax      ?? 0m;
    decimal total    = ViewBag.Total    ?? 0m;
    var availableDiscounts = (ViewBag.AvailableDiscounts as IEnumerable<Discount>) ?? Enumerable.Empty<Discount>();
}

<!-- QR Code Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>

<div class="container mt-5">
    <h2>Checkout</h2>
    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        </div>
    }
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning">
            @ViewBag.Message
        </div>
    }

    <div class="row">
        <div class="col-md-7">
            <h4>Select Payment Method</h4>
            <form asp-controller="Checkout" asp-action="Process" method="post" id="checkoutForm">
                <input type="hidden" name="subtotal" value="@ViewBag.Subtotal" />

                <!-- Discount Code Selection -->
                <div class="mb-4">
                    <label for="discountCode" class="form-label"><strong>Discount Code</strong></label>
                    <select class="form-select" name="discountCode" id="discountCode">
                        <option value="" data-pct="0">No discount</option>
                        @foreach (var d in availableDiscounts)
                        {
                            <option value="@d.DiscountCode" data-pct="@d.DiscountPercentage">
                                @d.DiscountCode — @d.DiscountName (@d.DiscountPercentage.ToString("0.##")% off)
                            </option>
                        }
                    </select>
                    @if (!availableDiscounts.Any())
                    {
                        <small class="text-muted">No active discount codes are available right now.</small>
                    }
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="paymentType" id="paymentCard" value="card" required checked>
                        <label class="form-check-label" for="paymentCard">Credit / Debit Card</label>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="radio" name="paymentType" id="paymentQR" value="qr" required>
                        <label class="form-check-label" for="paymentQR">QR Pay (TNG eWallet, GrabPay)</label>
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="radio" name="paymentType" id="paymentCOD" value="cod" required>
                        <label class="form-check-label" for="paymentCOD">Cash on Delivery</label>
                    </div>
                </div>

                <!-- Card Details Section -->
                <div id="cardDetailsContainer" class="border p-3 rounded bg-light mb-4">
                    <h5>Card Details</h5>
                    <div class="mb-2">
                        <label>Card Number</label>
                        <input type="text" class="form-control" placeholder="1234 5678 9101 1121" />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label>Expiry Date</label>
                            <input type="text" class="form-control" placeholder="MM/YY" />
                        </div>
                        <div class="col-6">
                            <label>CVV</label>
                            <input type="text" class="form-control" placeholder="123" />
                        </div>
                    </div>
                </div>

                <!-- QR Payment Info Section -->
                <div id="qrPaymentContainer" class="border p-3 rounded bg-light mb-4" style="display: none;">
                    <h5>📱 QR Payment Instructions</h5>
                    <p class="text-muted mb-0">Click the button below to view the QR code. Scan it with your e-wallet app to complete payment.</p>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" id="viewQRButton" class="btn btn-info btn-lg" style="display: none;">
                        📸 View QR Code to Scan
                    </button>
                    <button type="submit" class="btn btn-primary btn-lg w-100" id="placeOrderButton">Place Order (@ViewBag.Total.ToString("C"))</button>
                </div>
            </form>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    Order Summary
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in ViewBag.OrderItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Name (x@item.Quantity)
                                <span>@((item.Price * item.Quantity).ToString("C"))</span>
                            </li>
                        }
                        @if (!((IEnumerable<dynamic>)ViewBag.OrderItems).Any())
                        {
                            <li class="list-group-item text-muted">Your cart is empty.</li>
                        }
                    </ul>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Subtotal:</strong>
                        <span>@ViewBag.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between text-success" id="discountRow" style="display:none;">
                        <strong>Discount (<span id="discountLabel"></span>):</strong>
                        <span id="discountValue">-$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <strong>Tax (8%):</strong>
                        <span id="taxValue">@ViewBag.Tax.ToString("C")</span>
                    </div>
                    <h4 class="mt-3 d-flex justify-content-between">
                        Total: <span id="totalValue">@ViewBag.Total.ToString("C")</span>
                    </h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrCodeModal" tabindex="-1" role="dialog" aria-labelledby="qrCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="qrCodeModalLabel">📱 Scan QR Code to Pay</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <p class="text-muted">Open your e-wallet app and scan this QR code</p>
                    <canvas id="qrCanvas" width="300" height="300" class="border rounded p-2 bg-light"></canvas>
                </div>
                <div class="alert alert-info mb-0">
                    <strong>Amount to pay:</strong> <br>
                    <span id="qrAmount" class="h4 text-primary">@ViewBag.Total.ToString("C")</span>
                </div>
            </div>
            <div class="modal-footer">
                <p class="text-muted mb-0 w-100">
                    <small>Having trouble? You can complete the payment by clicking "Place Order" after scanning.</small>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    #qrCanvas {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    #viewQRButton {
        margin-bottom: 0.5rem;
    }

    .form-check-label {
        cursor: pointer;
        user-select: none;
    }

    .form-check-input:checked ~ .form-check-label {
        font-weight: 500;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const paymentTypeRadios = document.querySelectorAll('input[name="paymentType"]');
        const cardDetailsContainer = document.getElementById('cardDetailsContainer');
        const qrPaymentContainer = document.getElementById('qrPaymentContainer');
        const viewQRButton = document.getElementById('viewQRButton');
        const qrCodeModal = new bootstrap.Modal(document.getElementById('qrCodeModal'), {
            keyboard: false,
            backdrop: 'static'
        });

        // Payment method selection handler
        paymentTypeRadios.forEach(radio => {
            radio.addEventListener('change', function () {
                handlePaymentMethodChange(this.value);
            });
        });

        function handlePaymentMethodChange(paymentMethod) {
            // Hide all containers
            cardDetailsContainer.style.display = 'none';
            qrPaymentContainer.style.display = 'none';
            viewQRButton.style.display = 'none';

            // Show relevant container
            if (paymentMethod === 'card') {
                cardDetailsContainer.style.display = 'block';
            } else if (paymentMethod === 'qr') {
                qrPaymentContainer.style.display = 'block';
                viewQRButton.style.display = 'block';
            }
            // For COD, show nothing - just the Place Order button
        }

        // Generate QR code when button is clicked
        viewQRButton.addEventListener('click', function (e) {
            e.preventDefault();
            generateAndShowQRCode();
        });

        function generateAndShowQRCode() {
            const subtotal = parseFloat('@ViewBag.Subtotal');
            // Use the live total (reflects any selected discount); fall back to server value.
            const total = (typeof window.currentTotal === 'number')
                ? window.currentTotal
                : parseFloat('@ViewBag.Total');

            // Create QR code data (payment URL or transaction details)
            // Format: amount|currency|timestamp|reference
            const timestamp = Date.now();
            const qrData = `payment|MYR|${total.toFixed(2)}|${timestamp}|TNG_EWALLET_GRABPAY`;

            // Generate QR code using Qrious library
            const qr = new QRious({
                element: document.getElementById('qrCanvas'),
                value: qrData,
                size: 300,
                level: 'H',
                mime: 'image/png'
            });

            // Show the modal
            qrCodeModal.show();
        }

        // Initialize with card payment selected
        handlePaymentMethodChange('card');
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radios = document.querySelectorAll('input[name="paymentType"]');
        const cardDetails = document.getElementById('cardDetailsContainer');

        radios.forEach(radio => {
            radio.addEventListener('change', function () {
                if (this.value === 'card') {
                    cardDetails.style.display = 'block';
                } else {
                    cardDetails.style.display = 'none';
                }
            });
        });
    });
</script>

<!-- Live discount + total recalculation -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const SUBTOTAL = parseFloat('@ViewBag.Subtotal') || 0;
        const TAX_RATE = 0.08;

        const discountSelect = document.getElementById('discountCode');
        const discountRow = document.getElementById('discountRow');
        const discountLabel = document.getElementById('discountLabel');
        const discountValue = document.getElementById('discountValue');
        const taxValue = document.getElementById('taxValue');
        const totalValue = document.getElementById('totalValue');
        const placeOrderButton = document.getElementById('placeOrderButton');
        const qrAmount = document.getElementById('qrAmount');

        const money = v => '$' + v.toFixed(2);

        function recalculate() {
            const selected = discountSelect.options[discountSelect.selectedIndex];
            const pct = parseFloat(selected.getAttribute('data-pct')) || 0;

            const discountAmount = Math.round(SUBTOTAL * (pct / 100) * 100) / 100;
            const discountedSubtotal = SUBTOTAL - discountAmount;
            const tax = Math.round(discountedSubtotal * TAX_RATE * 100) / 100;
            const total = discountedSubtotal + tax;

            if (pct > 0) {
                discountLabel.textContent = pct + '%';
                discountValue.textContent = '-' + money(discountAmount);
                discountRow.style.display = 'flex';
            } else {
                discountRow.style.display = 'none';
            }

            taxValue.textContent = money(tax);
            totalValue.textContent = money(total);
            placeOrderButton.textContent = 'Place Order (' + money(total) + ')';
            if (qrAmount) {
                qrAmount.textContent = money(total);
            }

            // Expose the current total so the QR generator stays in sync.
            window.currentTotal = total;
        }

        discountSelect.addEventListener('change', recalculate);
        recalculate();
    });
</script>